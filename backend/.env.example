# Copiar este archivo a .env y completar los valores reales.
# Nunca subir el .env con claves reales al repositorio.

# Opción A: URL completa de PostgreSQL (Supabase, Neon o local)
DATABASE_URL=postgresql://usuario:password@host:5432/firststep

# Opción B: variables sueltas (si no usas DATABASE_URL)
# DB_HOST=localhost
# DB_PORT=5432
# DB_USER=usuario
# DB_PASSWORD=password
# DB_NAME=firststep

# Clave secreta para firmar los JWT (usar una cadena larga y aleatoria)
SECRET_KEY=cambia-esta-clave-por-una-larga-y-aleatoria

# Zona horaria usada para calcular "hoy"
APP_TIMEZONE=America/Bogota

# Orígenes permitidos por CORS, separados por coma (front local y deploy)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Nota: si DATABASE_URL está definida, tiene prioridad sobre las variables DB_*.
# Duración del token JWT en minutos (opcional, por defecto 10080 = 7 días)
# ACCESS_TOKEN_EXPIRE_MINUTES=10080
